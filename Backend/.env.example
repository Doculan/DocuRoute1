# DocuRoute — environment configuration
#
# Copy to Backend/.env and edit. Every setting here has a default in
# settings.py that matches how the project already runs, so an empty or
# absent .env changes nothing: development and the LAN demo need none of this.
#
# Real environment variables take precedence over this file, so a hosting
# platform's own configuration screen overrides it without further work.
#
# .env is gitignored. .env.example is committed and must never hold a real
# secret or password.


# ── Security ──────────────────────────────────────────────────

# Generate one per deployment, and do not reuse the development key:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Leaving this unset falls back to the development key that is committed in
# settings.py, which is fine locally and unacceptable in production.
DJANGO_SECRET_KEY=

# Never true on a public server: DEBUG returns tracebacks, settings and SQL
# to the browser on any error.
DJANGO_DEBUG=true

# Comma-separated. The default "*" suits the LAN demo, where the laptop's IP
# is whatever the router hands out. Name real hostnames in production.
DJANGO_ALLOWED_HOSTS=*


# ── Database ──────────────────────────────────────────────────
#
# Precedence: DATABASE_URL, then the DB_* variables, then the SQLite file.
# Unset everything for SQLite, which is what development and the demo use.

# One URL, the form most hosting platforms hand you:
#   DATABASE_URL=mysql://user:password@host:3306/docuroute
#   DATABASE_URL=postgres://user:password@host:5432/docuroute
#   DATABASE_URL=sqlite:///C:/data/qms.sqlite3
# Percent-encode any @ : / in the password (@ becomes %40).
DATABASE_URL=

# Or the same thing in pieces, if a URL is awkward to store:
# DB_ENGINE=mysql          # mysql | postgres | sqlite
# DB_NAME=docuroute
# DB_USER=docuroute
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Seconds to hold a database connection open for reuse. 0 opens a new one per
# request. Ignored by SQLite.
# DJANGO_CONN_MAX_AGE=60


# ── Assessment pipeline ───────────────────────────────────────

# v2 is the four-layer pipeline; v1 keeps the two older DistilBERT models for
# comparison. See README section 8.
# REVISION_AI_PIPELINE=v2
