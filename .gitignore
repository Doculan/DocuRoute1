node_modules/

# ML training artifacts (too large for git)
Backend/ml/training_checkpoints/
Backend/ml/saved_models/

# Virtual environment — each clone creates its own (see the pipeline README).
venv/
.venv/

# Python bytecode and test cache
__pycache__/
*.py[cod]
.pytest_cache/

# Local database backups
Backend/db.sqlite3.bak-*

# Layer 1 output cached to make repeated scoring runs cheap. Derived from
# all.jsonl and NOT checked for staleness, so committing it risks someone
# scoring a new dataset against old rule labels. Delete it to rebuild.
Backend/ml/reports/.rules_cache.json

# Regenerable drafts — the reviewed glossary.txt / entities.json are committed
Backend/ml/revision_pipeline/*_draft.*

# Throwaway dataset probes; context_v2 itself is committed
Backend/ml/datasets/_probe/

# Review pages contain manual excerpts; regenerate with build_review_page.py
Backend/ml/datasets/**/CHECKPOINT4_REVIEW.html
Backend/ml/datasets/**/*_REVIEW.html

# Per-fold splits are regenerated by make_splits.py
Backend/ml/datasets/**/fold_*/
Backend/ml/datasets/**/_final/

# The working database. It holds the extracted manual text; it is rebuilt by
# migrating and uploading, and it is not something two people can merge.
Backend/db.sqlite3
# WAL mode keeps a write-ahead log and a shared-memory index beside the
# database. Both are transient and rebuilt on connect.
Backend/db.sqlite3-wal
Backend/db.sqlite3-shm

# Real configuration: secret key, database credentials. Only .env.example,
# which holds no real values, belongs in version control.
.env
Backend/.env
